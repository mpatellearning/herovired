Gateway Service (Port 3003)

gateway-service/index.js
cat > ~/submission/gateway-service/index.js << 'EOF'
const express = require('express');
const http = require('http');
const app = express();
app.use(express.json());

function proxy(host, port, path, res) {
  http.get({ host, port, path }, upstream => {
    let data = '';
    upstream.on('data', chunk => data += chunk);
    upstream.on('end', () => {
      try { res.json(JSON.parse(data)); } catch { res.send(data); }
    });
  }).on('error', err => res.status(502).json({ error: 'Service unavailable' }));
}

app.get('/health',       (req, res) => res.json({ status: 'ok', service: 'gateway' }));
app.get('/users',        (req, res) => proxy('user-service',    3000, '/users', res));
app.get('/users/:id',    (req, res) => proxy('user-service',    3000, '/users/' + req.params.id, res));
app.get('/products',     (req, res) => proxy('product-service', 3001, '/products', res));
app.get('/products/:id', (req, res) => proxy('product-service', 3001, '/products/' + req.params.id, res));
app.get('/orders',       (req, res) => proxy('order-service',   3002, '/orders', res));
app.listen(3003, () => console.log('Gateway Service running on port 3003'));
EOF

